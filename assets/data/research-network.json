  "nodes": [
    {
      "id": "topic-1d-materials",
      "label": "One-dimensional materials",
      "sourceLabel": "1D Materials",
      "type": "topic",
      "description": "We synthesize and characterize carbon nanotubes and other one-dimensional materials, then translate their exceptional transport and mechanical properties into macroscopic conductors, fibers, and devices."
    },
    {
      "id": "topic-autonomous-experimentation",
      "label": "Autonomous experimentation",
      "sourceLabel": "Autonomous Experimentation",
      "type": "topic",
      "description": "Automation, online diagnostics, and data-driven decision making help the lab navigate large synthesis spaces and accelerate the discovery of useful materials and operating conditions."
    },
    {
      "id": "topic-climate-pollution",
      "label": "Climate and pollution",
      "sourceLabel": "Climate-Pollution",
      "type": "topic",
      "description": "We measure how particles form, evolve, and affect air quality and climate, spanning aviation, transportation, wildfire, and low-cost sensing applications."
    },
    {
      "id": "topic-energy-materials",
      "label": "Energy materials",
      "sourceLabel": "Energy materials",
      "type": "topic",
      "description": "The group develops materials and diagnostics for batteries, electrochemical systems, energy storage, and cleaner energy conversion."
    },
    {
      "id": "topic-methane",
      "label": "Methane conversion",
      "sourceLabel": "Methane",
      "type": "topic",
      "description": "We study catalytic and high-temperature pathways that convert methane into valuable solid carbon and hydrogen while improving selectivity, efficiency, and scalability."
    },
    {
      "id": "topic-solid-carbon",
      "label": "Sustainable nanocarbon",
      "sourceLabel": "Solid Carbon",
      "type": "topic",
      "description": "Gas-phase synthesis, reactor design, and multiscale characterization are used to produce useful carbon materials with lower emissions and stronger circular-economy potential."
    },
    {
      "id": "project-arpa-e-cnt",
      "label": "ARPA-E CNT",
      "type": "project",
      "description": "Scalable carbon-nanotube synthesis and processing for high-performance conductors."
    },
    {
      "id": "project-astera-mars",
      "label": "Astera Mars",
      "type": "project",
      "description": "Aerosol and atmospheric tools for understanding extreme and remote environments."
    },
    {
      "id": "project-battery-synthesis-equipment",
      "label": "Battery Synthesis Equipment",
      "type": "project",
      "description": "Automated equipment and diagnostics for repeatable energy-material synthesis."
    },
    {
      "id": "project-faa-boeing",
      "label": "FAA-Boeing",
      "type": "project",
      "description": "Measurement and modeling of aviation emissions, particle evolution, and climate-relevant impacts."
    },
    {
      "id": "project-kavli-1d-material",
      "label": "Kavli 1D Material",
      "type": "project",
      "description": "Fundamental synthesis and characterization of one-dimensional materials."
    },
    {
      "id": "project-precourt-conductors",
      "label": "Precourt Conductors",
      "type": "project",
      "description": "Lightweight nanocarbon conductors for electrified energy systems."
    },
    {
      "id": "project-slac-battery",
      "label": "SLAC-Battery",
      "type": "project",
      "description": "Advanced battery materials and coupled electrochemical characterization."
    },
    {
      "id": "project-steer",
      "label": "STEER",
      "type": "project",
      "description": "Reactor and process development for methane conversion and solid-carbon production."
    },
    {
      "id": "project-spark",
      "label": "Spark",
      "type": "project",
      "description": "Autonomous experimentation for catalyst and reaction-space discovery."
    },
