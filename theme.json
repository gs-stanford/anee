{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "custom": {
      "radius": {
        "card": "24px",
        "pill": "999px"
      },
      "shadow": {
        "soft": "0 28px 80px rgba(28, 18, 43, 0.11)"
      }
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "canvas",
          "color": "#ffffff",
          "name": "Canvas"
        },
        {
          "slug": "surface",
          "color": "#ffffff",
          "name": "Surface"
        },
        {
          "slug": "ink",
          "color": "#12131a",
          "name": "Ink"
        },
        {
          "slug": "muted",
          "color": "#5f6368",
          "name": "Muted"
        },
        {
          "slug": "cardinal",
          "color": "#442067",
          "name": "Grape"
        },
        {
          "slug": "cardinal-soft",
          "color": "#a78bfa",
          "name": "Electric Violet"
        },
        {
          "slug": "gold",
          "color": "#58d7cf",
          "name": "Aerosol Cyan"
        },
        {
          "slug": "line",
          "color": "#dedfe7",
          "name": "Line"
        }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1440px"
    },
    "spacing": {
      "blockGap": true,
      "spacingScale": {
        "operator": "*",
        "increment": 1.4,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      },
      "units": [
        "px",
        "rem",
        "%",
        "vh",
        "vw"
      ]
    },
    "typography": {
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Instrument Serif\", \"Iowan Old Style\", Georgia, serif",
          "name": "Editorial Serif",
          "slug": "editorial"
        },
        {
          "fontFamily": "\"Space Grotesk\", \"Avenir Next\", sans-serif",
          "name": "Clean Sans",
          "slug": "clean"
        }
      ],
      "fontSizes": [
        {
          "slug": "sm",
          "size": "0.95rem",
          "name": "Small"
        },
        {
          "slug": "md",
          "size": "1.12rem",
          "name": "Medium"
        },
        {
          "slug": "lg",
          "size": "1.45rem",
          "name": "Large"
        },
        {
          "slug": "xl",
          "size": "2.35rem",
          "name": "Extra Large"
        },
        {
          "slug": "hero",
          "size": "clamp(3.4rem, 8vw, 6.4rem)",
          "name": "Hero"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "var(--wp--preset--color--ink)"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "999px"
        },
        "color": {
          "background": "var(--wp--preset--color--gold)",
          "text": "var(--wp--preset--color--surface)"
        },
        "spacing": {
          "padding": {
            "top": "0.95rem",
            "bottom": "0.95rem",
            "left": "1.6rem",
            "right": "1.6rem"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--clean)",
          "fontSize": "1rem",
          "fontWeight": "600"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--editorial)",
          "fontWeight": "700",
          "lineHeight": "1.02"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--cardinal)"
        },
        "typography": {
          "textDecoration": "none"
        }
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "999px"
        }
      },
      "core/group": {
        "border": {
          "radius": "0"
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--clean)",
          "fontWeight": "600"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--editorial)"
        }
      },
      "core/query-pagination-numbers": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--clean)"
        }
      }
    },
    "spacing": {
      "blockGap": "1.35rem"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--clean)",
      "fontSize": "1.05rem",
      "lineHeight": "1.65"
    }
  }
}
